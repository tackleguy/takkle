# Kit (ConvertKit) API Configuration
# Get your API key from: https://app.kit.com/account/edit
KIT_API_KEY=your_kit_api_key_here

# Kit Form ID
# Find this in Kit under Forms > select your form > the ID is in the URL
KIT_FORM_ID=your_form_id_here

NEXT_PUBLIC_SUPABASE_URL=https://nwxgovpuwxiksmrhsmkk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Expose schema "takkle" in Supabase Dashboard → Settings → API → Exposed schemas
# Migrations live in supabase/migrations/

# School list for local helpers (default: synthetic seed — keeps demo players valid).
# Set to "nces" to use src/data/seed/schools-nces-sample.json from the CCD importer.
# Full NCES dump: data/nces/schools.json (gitignored; run: npm run import:nces-schools)
# Source: https://nces.ed.gov/ccd/Data/zip/ccd_sch_029_2425_w_0a_051425.zip (U.S. gov / public domain)
# TAKKLE_SCHOOLS_SOURCE=synthetic
# TAKKLE_SCHOOLS_SOURCE=nces

# CollegeFootballData recruiting importer (real HS prospect names).
# Free API key: https://collegefootballdata.com → account dashboard
# CFBD_API_KEY=your_cfbd_api_key_here
# Import: npm run import:cfbd-recruits
# Full dump: data/cfbd/ (gitignored). Sample: src/data/seed/players-cfbd-sample.json
# Use --embed-all to put the full import into the seed sample path for local UI.
# Player list for the app.
# Discover / Rankings / Claim prefer live Supabase `takkle.players` when URL+key are set.
# Local seed fallback (only when Supabase is unset/unreachable):
#   synthetic = 3k demo names (NOT real recruits)
#   cfbd      = CollegeFootballData sample (real names; sample file may be empty until import)
#   supabase  = hide synthetic banners; force live-oriented UX
TAKKLE_PLAYERS_SOURCE=supabase
NEXT_PUBLIC_TAKKLE_PLAYERS_SOURCE=supabase
# TAKKLE_PLAYERS_SOURCE=synthetic
# TAKKLE_PLAYERS_SOURCE=cfbd
